# ==================================================
# .gitignore de ExpoU
# ==================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Entorno virtual (se recrea con requirements.txt) ---
.venv/
venv/

# --- Configuración local de editor ---
.vscode/
.DS_Store

# ==================================================
# MODELOS ENTRENADOS
# ==================================================
# Por defecto ignoramos los .pkl (archivos binarios regenerables).
*.pkl

# EXCEPCIÓN: los modelos independientes del entrenamiento de 5 agentes
# (100 episodios) SÍ se versionan como respaldo. Tardan en generarse
# y el proyecto exige no perderlos ni reentrenarlos sin justificación.
!q_table_independiente_*.pkl

# ==================================================
# SALIDAS TEMPORALES DE SIMULACIONES DE SUMO
# ==================================================
# Se regeneran al ejecutar las simulaciones; no se versionan.
tripinfos.xml
stopinfos.xml
stats.xml
resultados_normal.xml
resumen_normal.xml
resultados_ia_5.xml
resumen_ia_5.xml

# Salidas del evaluador de la Etapa 2 (archivos por corrida, regenerables).
# El CSV final (evaluacion_etapa2.csv) SI se versiona como evidencia.
salidas_evaluacion/

# ==================================================
# ARCHIVOS GRANDES / NO RELACIONADOS CON EL CÓDIGO
# ==================================================
# PDFs y documentos pesados (p. ej. historiales de conversaciones)
# no forman parte del proyecto y pueden exceder el límite de GitHub.
*.pdf
